{
  "name": "r3f-fluid-sim",
  "description": "Real-time 2D fluid velocity simulation for React Three Fiber.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heinergiehl/r3f-fluid-sim.git",
    "directory": "packages/fluid"
  },
  "bugs": {
    "url": "https://github.com/heinergiehl/r3f-fluid-sim/issues"
  },
  "homepage": "https://github.com/heinergiehl/r3f-fluid-sim#readme",
  "keywords": [
    "react-three-fiber",
    "three",
    "fluid",
    "simulation",
    "gpgpu",
    "shader"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.96.0",
    "@react-three/fiber": "^8.15.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vite-plugin-glsl": "^1.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
